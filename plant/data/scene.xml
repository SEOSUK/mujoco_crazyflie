<mujoco model="cf21B_scene">
  <include file="cf21B_500.xml"/>
  <include file="wall.xml"/>

  <asset>
    <texture
      name="tile_tex"
      type="2d"
      builtin="checker"
      rgb1="0.98 0.98 0.98"
      rgb2="0.90 0.90 0.90"
      width="512"
      height="512"/>
    <material
      name="tile_mat"
      texture="tile_tex"
      texrepeat="8 8"
      reflectance="0.3"/>
  </asset>

  <default>
    <default class="env_ground">
      <geom contype="1" conaffinity="6" friction="1.0 0 0" condim="3" margin="0" gap="0"/>
    </default>
  </default>

  <worldbody>
    <geom
      name="ground"
      type="plane"
      size="5 5 0.1"
      pos="0 0 0"
      material="tile_mat"
      class="env_ground"/>
  </worldbody>
</mujoco>